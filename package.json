{
  "name": "kalkul",
  "version": "2.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:all": "pnpm lint && pnpm check && pnpm knip && pnpm check-locales && pnpm check-versions",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check-locales": "tsx scripts/check-locales",
    "check-versions": "tsx scripts/check-versions",
    "knip": "knip && knip --production",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.70.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.9.9",
    "@types/ws": "8.18.2",
    "autoprefixer": "10.6.2",
    "bits-ui": "2.20.6",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "knip": "6.44.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "svelte-i18n": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "type": "module",
  "engines": {
    "node": ">=22.17",
    "pnpm": "11.x"
  }
